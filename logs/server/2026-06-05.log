2026-06-05T18:39:04.489+08:00 [WARN] {981d6f051f29b6189348561162dd0814} [FinanceAggregate] 查询 douyin 订单失败: 
		SELECT
			o.talent_id,
			COUNT(DISTINCT o.main_order_no) AS total_order_count,
			COUNT(DISTINCT CASE WHEN (o.order_status IN ('已发货','待发货','已完成') AND o.after_sale_status NOT IN ('6','7','12')) OR (o.order_status = '已关闭' AND o.after_sale_status IN ('27','28','51')) THEN o.main_order_no END) AS order_count,
			COUNT(DISTINCT CASE WHEN o.after_sale_status IN ('6','7','12') THEN o.main_order_no END) AS invalid_order_count,
			COALESCE(SUM(CASE WHEN (o.order_status IN ('已发货','待发货','已完成') AND o.after_sale_status NOT IN ('6','7','12')) OR (o.order_status = '已关闭' AND o.after_sale_status IN ('27','28','51')) THEN o.product_num ELSE 0 END), 0) AS product_num,
			COALESCE(SUM(CASE WHEN (o.order_status IN ('已发货','待发货','已完成') AND o.after_sale_status NOT IN ('6','7','12')) OR (o.order_status = '已关闭' AND o.after_sale_status IN ('27','28','51')) THEN COALESCE(o.product_price, 0) * o.product_num ELSE 0 END), 0) AS pay_amount,
			COALESCE(SUM(CASE WHEN (o.order_status IN ('已发货','待发货','已完成') AND o.after_sale_status NOT IN ('6','7','12')) OR (o.order_status = '已关闭' AND o.after_sale_status IN ('27','28','51')) THEN COALESCE(g.base_price, o.product_price) * o.product_num ELSE 0 END), 0) AS cost_amount,
			COALESCE(SUM(CASE WHEN o.after_sale_status IN ('6','7','12') AND o.order_status = '已发货' THEN COALESCE(o.product_price, 0) * o.product_num ELSE 0 END), 0) AS refund_cost_amount,
			COUNT(DISTINCT CASE WHEN o.after_sale_status IN ('6','7','12') AND o.order_status = '已发货' THEN o.main_order_no END) AS refund_order_count,
			COUNT(DISTINCT CASE WHEN (o.order_status IN ('已发货','待发货','已完成') AND o.after_sale_status NOT IN ('6','7','12')) OR (o.order_status = '已关闭' AND o.after_sale_status IN ('27','28','51')) AND g.base_price > 0 THEN o.main_order_no END) AS valid_order_cost_match
